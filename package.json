	"devDependencies": {
		"@tailwindcss/postcss": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/bcrypt": "6.0.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@vitest/coverage-v8": "5.1.0",
		"baseline-browser-mapping": "2.11.35",
		"dotenv-cli": "11.1.0",
		"drizzle-kit": "0.31.11",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"jsdom": "31.0.0",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.5",
		"tsx": "4.23.15",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vitest": "5.1.0"
	},
	"name": "health-card",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "26.x",
		"pnpm": "12.18.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"env:pull:dev": "vercel env pull .env.development.local --environment=development",
		"env:pull:preview": "vercel env pull .env.preview.local --environment=preview",
		"env:pull:prod": "vercel env pull .env.production.local --environment=production",
		"preview": "VERCEL_ENV=preview dotenv -e .env.preview.local -- next start",
		"prod": "VERCEL_ENV=production dotenv -e .env.production.local -- next start",
		"build": "next build --turbopack",
		"build:vercel": "if [ \"$VERCEL_ENV\" = \"production\" ] || { [ \"$VERCEL_ENV\" = \"preview\" ] && [ -n \"$DATABASE_URL\" ]; }; then pnpm migrate:deploy; else echo \"Skipping DB migrations for $VERCEL_ENV\"; fi && next build --turbopack",
		"start": "next start",
		"lint": "eslint .",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed.ts",
		"migrate:deploy": "drizzle-kit migrate"
	},
	"version": "0.1.0",
	"browserslist": {
		"production": [
			"supports es6-module",
			"not safari < 15",
			"not ios_saf < 15",
			"not firefox < 100",
			"not chrome < 100"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
